<Project>

  <!-- Общие свойства для всех проектов решения RevitNvf. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Параметры Revit. RevitApiDir можно переопределить переменной окружения
       или /p:RevitApiDir=... при сборке, если Revit установлен не по умолчанию. -->
  <PropertyGroup>
    <RevitVersion>2024</RevitVersion>
    <RevitApiDir Condition="'$(RevitApiDir)' == ''">C:\Program Files\Autodesk\Revit $(RevitVersion)\</RevitApiDir>
  </PropertyGroup>

</Project>
