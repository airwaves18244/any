<Project Sdk="Microsoft.NET.Sdk">

  <!-- Revit-адаптер: IExternalApplication/IExternalCommand, транзакции,
       размещение семейств. net48 (Revit 2024). Собирается ТОЛЬКО на Windows
       с установленным Revit 2024 (нужны локальные RevitAPI*.dll). -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>RevitNvf.Revit</RootNamespace>
    <AssemblyName>RevitNvf.Revit</AssemblyName>
    <!-- Revit грузит сборку из своего домена; PDB-портативность не нужна. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Хостинг WPF dockable-панели из RevitNvf.UI (FrameworkElement). -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- Локальные ссылки на Revit API (Copy Local = False). -->
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiDir)RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiDir)RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevitNvf.Core\RevitNvf.Core.csproj" />
    <ProjectReference Include="..\RevitNvf.UI\RevitNvf.UI.csproj" />
  </ItemGroup>

  <!-- Post-build: копирование сборки и манифеста в папку Addins Revit (только Windows). -->
  <Target Name="DeployAddin" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <AddinDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\</AddinDir>
    </PropertyGroup>
    <MakeDir Directories="$(AddinDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AddinDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\build\RevitNvf.addin" DestinationFolder="$(AddinDir)" SkipUnchangedFiles="false" />
  </Target>

</Project>
